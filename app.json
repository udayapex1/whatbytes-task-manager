{
  "expo": {
    "name": "WhatBytes Task Manager",
    "slug": "whatbytes-task-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/files/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#25343F",
        "foregroundImage": "./assets/files/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/files/icon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font"
    ]
  }
}
